# ---------- app ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000

# ---------- infra ----------
# Points at the machine's local PostgreSQL 18 service (same instance as the other project DBs).
# Redis comes from docker-compose. See the note at the top of docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications?schema=public
REDIS_URL=redis://localhost:6379

# ---------- auth ----------
# Seeded API key for /v1/* calls. Send it as the `x-api-key` header.
API_KEY_SEED=dev-key-please-change
# HMAC secret for one-click unsubscribe links.
UNSUBSCRIBE_TOKEN_SECRET=change-me-unsubscribe-secret

# ---------- providers ----------
# sandbox = force Resend's *@resend.dev test addresses so nothing reaches real inboxes.
# live    = send to the recipient's real address.
PROVIDER_MODE=sandbox

# Email: https://resend.com/api-keys  (free tier: 100/day, 3k/month, 10 req/s)
RESEND_API_KEY=
RESEND_FROM=Notify <onboarding@resend.dev>
# https://resend.com/webhooks -> signing secret (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Allow unsigned webhook posts in development (NEVER enable outside dev).
WEBHOOK_ALLOW_UNSIGNED=true

# Email failover target. Points at the docker-compose mailhog by default.
SMTP_URL=smtp://localhost:1025
SMTP_FROM=Notify <notify@localhost>

# Web Push: generate a keypair with `npm run keys:vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# SMS: mock | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- tuning ----------
# Email queue limiter. Resend allows 10 req/s per team; stay under it.
EMAIL_RATE_LIMIT_PER_SEC=8
# Consecutive provider failures before the circuit breaker opens.
CIRCUIT_BREAKER_THRESHOLD=5
# How long the breaker stays open before a half-open probe (ms).
CIRCUIT_BREAKER_RESET_MS=30000
# Outbox relay poll interval (ms).
OUTBOX_POLL_INTERVAL_MS=500
# Delete DeliveryEvent rows older than this.
RETENTION_DAYS=30
